APP_NAME=Trung Chinese Learning API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chinese_learning
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chinese_learning_test

SECRET_KEY=replace-this-local-development-secret-with-a-random-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=DEBUG
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_INPUT_VERSION=v1
EMBEDDING_NORMALIZE=true
RAG_RETRIEVAL_CANDIDATE_K=20
RAG_EVIDENCE_CALIBRATION_MODE=false
# Frozen by D-093 after Step 7.3 calibration; rerank scores are not probabilities.
RAG_MIN_RERANK_SCORE=-1.0815147161483765
EXTERNAL_RETRIEVAL_PROVIDER=tavily
EXTERNAL_RETRIEVAL_BASE_URL=https://api.tavily.com
EXTERNAL_RETRIEVAL_API_KEY=
EXTERNAL_RETRIEVAL_K=10
EXTERNAL_RETRIEVAL_ALLOWED_DOMAINS=www.open.edu,en.wiktionary.org,www.chinesetest.cn
EXTERNAL_RETRIEVAL_REQUEST_TIMEOUT_SECONDS=10
RAG_MEMORY_MAX_TURNS=3
RERANKER_PROVIDER=local
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_TOP_K=5
RERANKER_INPUT_VERSION=v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini-2026-03-17
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_TRANSIENT_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=800
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=none
LLM_MODEL_INPUT_LIMIT=400000
AI_GENERATION_MAX_QUESTIONS=10
AI_GENERATION_MAX_OUTPUT_TOKENS=4000
