  "readings": [
    {
      "order_index": 1,
      "title": "Hẹn giờ gặp nhau",
      "content": "白家月:现在几点?\n安妮:早上八点四十分。\n白家月:我上午十点十分有课。\n安妮:好的,我们下午两点见吧。",
      "pinyin": "bái jiā yuè : xiàn zài jǐ diǎn ?\nān nī : zǎo shàng bā diǎn sì shí fēn 。\nbái jiā yuè : wǒ shàng wǔ shí diǎn shí fēn yǒu kè 。\nān nī : hǎo de , wǒ men xià wǔ liǎng diǎn jiàn ba 。",
      "vietnamese_translation": "Bạch Gia Nguyệt: Bây giờ mấy giờ rồi?\nAnnie: 8 giờ 40 phút sáng.\nBạch Gia Nguyệt: Buổi sáng 10 giờ 10 phút tôi có tiết học.\nAnnie: Được rồi, chúng ta gặp nhau lúc 2 giờ chiều nhé.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 7, PDF 62."
    },
    {
      "order_index": 2,
      "title": "Rủ bạn xem phim",
      "content": "李文:下午我想去电影院看电影,你去吗?\n白家月:我不想去,下午还有事。\n李文:好的,明天呢?\n白家月:我明天下午两点还上课呢,四点半下课。",
      "pinyin": "lǐ wén : xià wǔ wǒ xiǎng qù diàn yǐng yuàn kàn diàn yǐng , nǐ qù ma ?\nbái jiā yuè : wǒ bù xiǎng qù , xià wǔ hái yǒu shì 。\nlǐ wén : hǎo de , míng tiān ne ?\nbái jiā yuè : wǒ míng tiān xià wǔ liǎng diǎn hái shàng kè ne , sì diǎn bàn xià kè 。",
      "vietnamese_translation": "Lý Văn: Chiều nay tớ muốn đi rạp chiếu phim xem phim, bạn đi không?\nBạch Gia Nguyệt: Tớ không muốn đi, chiều nay còn có việc.\nLý Văn: Được thôi, thế ngày mai thì sao?\nBạch Gia Nguyệt: Chiều mai lúc hai giờ tớ vẫn còn phải đi học,bốn giờ rưỡi tan học.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 7, PDF 64, 65."
    },
    {
      "order_index": 3,
      "title": "Giờ tan làm",
      "content": "王一雪:喂,你在哪儿呢?\n刘明:我在家里呢。\n王一雪:我晚上六点半下班。\n刘明:我八点去医院上班。\n王一雪:好的,你去店里买些菜吧。\n刘明:好,我十分钟后去。",
      "pinyin": "wáng yī xuě : wèi , nǐ zài nǎ ér ne ?\nliú míng : wǒ zài jiā lǐ ne 。\nwáng yī xuě : wǒ wǎn shàng liù diǎn bàn xià bān 。\nliú míng : wǒ bā diǎn qù yī yuàn shàng bān 。\nwáng yī xuě : hǎo de , nǐ qù diàn lǐ mǎi xiē cài ba 。\nliú míng : hǎo , wǒ shí fēn zhōng hòu qù 。",
      "vietnamese_translation": "Vương Nhất Tuyết:  Alô, anh đang ở đâu vậy?\nLưu Minh: Anh đang ở nhà.\nVương Nhất Tuyết: Buổi tối sáu giờ rưỡi em tan làm.\nLưu Minh: Tám giờ anh đi bệnh viện làm việc.\nVương Nhất Tuyết: Vâng, anh đi cửa hàng mua ít rau đi nhé.\nLưu Minh: Được, mười phút nữa anh đi.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 7, PDF 67, 68."
    }
