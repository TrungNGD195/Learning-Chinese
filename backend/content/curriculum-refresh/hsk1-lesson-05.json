  "readings": [
    {
      "order_index": 1,
      "title": "Hỏi ngày tháng và thứ",
      "content": "小丽:请问,今天几月几号?\n小刚:今天11月21号(日)。\n小丽:明天星期几?\n小刚:星期日。明天我休息。",
      "pinyin": "xiǎo lì : qǐng wèn , jīn tiān jǐ yuè jǐ hào ?\nxiǎo gāng : jīn tiān 1 1 yuè 2 1 hào ( rì ) 。\nxiǎo lì : míng tiān xīng qī jǐ ?\nxiǎo gāng : xīng qī rì 。 míng tiān wǒ xiū xī 。",
      "vietnamese_translation": "Tiểu Lệ:Xin hỏi, hôm nay là ngày mấy tháng mấy?\nTiểu Cương:Hôm nay là ngày 21 tháng 11.\nTiểu Lệ:Ngày mai là thứ mấy?\nTiểu Cương :Chủ nhật. Ngày mai tôi nghỉ.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 5, PDF 42."
    },
    {
      "order_index": 2,
      "title": "Bạn biết nấu món gì?",
      "content": "小丽:你会做饭吗?\n小刚:我会做。\n小丽:你会做什么?\n小刚:我会做面条儿、饺子,也会做一些菜,星期天我也做饭。",
      "pinyin": "xiǎo lì : nǐ huì zuò fàn ma ?\nxiǎo gāng : wǒ huì zuò 。\nxiǎo lì : nǐ huì zuò shén me ?\nxiǎo gāng : wǒ huì zuò miàn tiáo ér 、 jiǎo zi , yě huì zuò yī xiē cài , xīng qī tiān wǒ yě zuò fàn 。",
      "vietnamese_translation": "Tiểu Lệ: Bạn biết nấu ăn không?\nTiểu Cương: Tôi có biết.\nTiểu Lệ: Bạn biết nấu món gì?\nTiểu Cương: Tôi biết làm mì, sủi\ncảo, cũng biết nấu một vài món ăn,\nchủ nhật tôi cũng nấu cơm.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 5, PDF 44, 45."
    },
    {
      "order_index": 3,
      "title": "Chiếc máy tính mới",
      "content": "小丽:小刚,下班吗?\n小刚:下班。\n小丽:这是你的新电脑吗?\n小刚:是的,是我的新电脑。\n小丽:真好看!\n小刚:我也很喜欢它。",
      "pinyin": "xiǎo lì : xiǎo gāng , xià bān ma ?\nxiǎo gāng : xià bān 。\nxiǎo lì : zhè shì nǐ de xīn diàn nǎo ma ?\nxiǎo gāng : shì de , shì wǒ de xīn diàn nǎo 。\nxiǎo lì : zhēn hǎo kàn !\nxiǎo gāng : wǒ yě hěn xǐ huān tā 。",
      "vietnamese_translation": "Tiểu Lệ: Tiểu Cương, bạn tan làm chưa?\nTiểu Cương: Tan làm rồi.\nTiểu Lệ: Đây là máy tính mới của bạn à?\nTiểu Cương: Đúng vậy, là máy tính mới của tôi.\nTiểu Lệ: Đẹp thật đấy!\nTiểu Cương: Tôi cũng rất thích nó.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 5, PDF 47, 48."
    }
