  "readings": [
    {
      "order_index": 1,
      "title": "Chào lớp và giới thiệu tên",
      "content": "老师:大家好!\n同学们:您好!\n小丽:你们好!我叫小丽。\n同学们:你好,小丽!",
      "pinyin": "lǎo shī : dà jiā hǎo !\ntóng xué men : nín hǎo !\nxiǎo lì : nǐ men hǎo ! wǒ jiào xiǎo lì 。\ntóng xué men : nǐ hǎo , xiǎo lì !",
      "vietnamese_translation": "Cô giáo: Chào mọi người!\nCác bạn học: Chào cô ạ!\nTiểu Lệ: Chào các bạn! Tôi tên là Tiểu Lệ.\nCác bạn học: Chào Tiểu Lệ!",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 2, PDF 13."
    },
    {
      "order_index": 2,
      "title": "Cảm ơn và đáp lời",
      "content": "老师:同学们,谢谢!\n同学们:不客气!",
      "pinyin": "lǎo shī : tóng xué men , xiè xiè !\ntóng xué men : bú kè qì !",
      "vietnamese_translation": "Cô giáo: Cảm ơn các bạn!\nCác bạn học: Không có gì ạ!",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 2, PDF 14."
    },
    {
      "order_index": 3,
      "title": "Xin lỗi và đáp lời",
      "content": "李文:对不起!\n白家月:没关系!",
      "pinyin": "lǐ wén : duì bù qǐ !\nbái jiā yuè : méi guān xì !",
      "vietnamese_translation": "Lý Văn: Xin lỗi!\nBạch Gia Nguyệt: Không sao đâu!",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 2, PDF 15."
    },
    {
      "order_index": 4,
      "title": "Làm quen",
      "content": "李文:你好!我叫李文。\n白家月:你好!我叫白家月。\n李文:很高兴认识你。\n白家月:认识你我也很高兴。",
      "pinyin": "lǐ wén : nǐ hǎo ! wǒ jiào lǐ wén 。\nbái jiā yuè : nǐ hǎo ! wǒ jiào bái jiā yuè 。\nlǐ wén : hěn gāo xìng rèn shí nǐ 。\nbái jiā yuè : rèn shí nǐ wǒ yě hěn gāo xìng 。",
      "vietnamese_translation": "Lý Văn: Xin chào! Tôi tên là Lý Văn.\nBạch Gia Nguyệt: Xin chào! Tôi tên là Bạch Gia Nguyệt.\nLý Văn: Rất vui được làm quen với bạn.\nBạch Gia Nguyệt: Tôi cũng rất vui được làm quen với bạn.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 2, PDF 16."
    }
  ],
