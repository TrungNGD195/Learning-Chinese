  "readings": [
    {
      "order_index": 1,
      "title": "Số học sinh trong lớp",
      "content": "刘明:一飞忙吗?\n王一雪:她很忙。\n刘明:她有多少个学生?\n王一雪:她有二十个学生。",
      "pinyin": "liú míng : yī fēi máng ma ?\nwáng yī xuě : tā hěn máng 。\nliú míng : tā yǒu duō shǎo gè xué shēng ?\nwáng yī xuě : tā yǒu èr shí gè xué shēng 。",
      "vietnamese_translation": "Lưu Minh: Nhất Phi có bận không?\nVương Nhất Tuyết: Cô ấy rất bận.\nLưu Minh: Cô ấy có bao nhiêu học sinh?\nVương Nhất Tuyết: Cô ấy có hai mươi học sinh.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 4, PDF 33."
    },
    {
      "order_index": 2,
      "title": "Gia đình có mấy người?",
      "content": "王一雪:我有两个哥哥,你呢?\n杨同乐:我没有哥哥。\n王一雪:你家有几口人?\n杨同乐:我家有四口人,爸爸、妈妈、妹妹和我。",
      "pinyin": "wáng yī xuě : wǒ yǒu liǎng gè gē gē , nǐ ne ?\nyáng tóng lè : wǒ méi yǒu gē gē 。\nwáng yī xuě : nǐ jiā yǒu jǐ kǒu rén ?\nyáng tóng lè : wǒ jiā yǒu sì kǒu rén , bà bà 、 mā mā 、 mèi mèi hé wǒ 。",
      "vietnamese_translation": "Vương Nhất Tuyết: Tôi có 2 anh trai, bạn thì sao?\nDương Đồng Lạc: Tôi không có anh trai.\nVương Nhất Tuyết: Nhà bạn có mấy người?\nDương Đồng Lạc: Nhà tôi có 4 người: bố, mẹ, em gái và tôi.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 4, PDF 35."
    },
    {
      "order_index": 3,
      "title": "Giới thiệu con và hỏi tuổi",
      "content": "杨同乐:这是您儿子吗?\n王一雪:是的,我有两个孩子,一个儿子,一个女儿。\n杨同乐:您儿子几岁?\n王一雪:他今年五岁。\n杨同乐:您女儿多大?\n王一雪:她今年十二。",
      "pinyin": "yáng tóng lè : zhè shì nín ér zi ma ?\nwáng yī xuě : shì de , wǒ yǒu liǎng gè hái zi , yí gè ér zi , yí gè nǚ ér 。\nyáng tóng lè : nín ér zi jǐ suì ?\nwáng yī xuě : tā jīn nián wǔ suì 。\nyáng tóng lè : nín nǚ ér duō dà ?\nwáng yī xuě : tā jīn nián shí èr 。",
      "vietnamese_translation": "Dương Đồng Lạc: Đây là con trai của chị à?\nVương Nhất Tuyết: Đúng vậy, tôi có hai đứa con, một đứa con trai, một đứa con gái.\nDương Đồng Lạc: Con trai chị mấy tuổi?\nVương Nhất Tuyết: Năm nay nó 5 tuổi.\nDương Đồng Lạc: Con gái chị bao nhiêu tuổi?\nVương Nhất Tuyết: Năm nay nó 12 tuổi.",
      "source_reference": "Giáo trình HSK1 3.0 Hanu, bài 4, PDF 37."
    }
